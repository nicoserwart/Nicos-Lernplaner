<!DOCTYPE html>

<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nico's Warmup System</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0a0a0f;
  --surface: #111118;
  --surface2: #18181f;
  --border: rgba(255,255,255,0.07);
  --text: #f0f0f0;
  --muted: #666;
  --mon: #3b82f6;
  --mon-dim: rgba(59,130,246,0.12);
  --wed: #22c55e;
  --wed-dim: rgba(34,197,94,0.12);
  --fri: #f97316;
  --fri-dim: rgba(249,115,22,0.12);
  --sat: #a855f7;
  --sat-dim: rgba(168,85,247,0.12);
  --mob: #f43f5e;
  --mob-dim: rgba(244,63,94,0.12);
}

- { margin: 0; padding: 0; box-sizing: border-box; }

body {
background: var(–bg);
color: var(–text);
font-family: ‘DM Sans’, sans-serif;
min-height: 100vh;
overflow-x: hidden;
}

/* ── BACKGROUND TEXTURE ── */
body::before {
content: ‘’;
position: fixed;
inset: 0;
background:
radial-gradient(ellipse 80% 60% at 20% 0%, rgba(59,130,246,0.06) 0%, transparent 60%),
radial-gradient(ellipse 60% 40% at 80% 100%, rgba(168,85,247,0.06) 0%, transparent 60%);
pointer-events: none;
z-index: 0;
}

.wrap { position: relative; z-index: 1; max-width: 900px; margin: 0 auto; padding: 48px 24px 80px; }

/* ── HEADER ── */
.header { margin-bottom: 56px; }

.header-eyebrow {
font-family: ‘DM Mono’, monospace;
font-size: 11px;
letter-spacing: 0.2em;
color: var(–muted);
text-transform: uppercase;
margin-bottom: 12px;
}

.header-title {
font-family: ‘Bebas Neue’, sans-serif;
font-size: clamp(52px, 10vw, 88px);
line-height: 0.9;
letter-spacing: 0.02em;
color: var(–text);
margin-bottom: 20px;
}

.header-title span {
-webkit-text-stroke: 1px rgba(255,255,255,0.3);
color: transparent;
}

.header-sub {
font-size: 14px;
color: var(–muted);
font-weight: 300;
max-width: 420px;
line-height: 1.6;
}

/* ── TABS ── */
.tabs {
display: flex;
gap: 4px;
margin-bottom: 32px;
background: var(–surface);
border: 1px solid var(–border);
border-radius: 14px;
padding: 6px;
overflow-x: auto;
}

.tab {
flex: 1;
min-width: 120px;
padding: 10px 16px;
border-radius: 10px;
border: none;
background: transparent;
color: var(–muted);
font-family: ‘DM Sans’, sans-serif;
font-size: 13px;
font-weight: 500;
cursor: pointer;
transition: all 0.2s;
white-space: nowrap;
text-align: center;
}

.tab:hover { color: var(–text); background: var(–surface2); }

.tab.active {
color: #000;
font-weight: 600;
}

.tab[data-day=“mo”].active { background: var(–mon); }
.tab[data-day=“mi”].active { background: var(–wed); }
.tab[data-day=“fr”].active { background: var(–fri); }
.tab[data-day=“sa”].active { background: var(–sat); }
.tab[data-day=“mob”].active { background: var(–mob); }

/* ── SECTION PANEL ── */
.panel { display: none; }
.panel.active { display: block; animation: fadeUp 0.3s ease; }

@keyframes fadeUp {
from { opacity: 0; transform: translateY(12px); }
to   { opacity: 1; transform: translateY(0); }
}

/* ── PANEL HEADER ── */
.panel-hdr {
display: flex;
align-items: flex-end;
justify-content: space-between;
margin-bottom: 28px;
gap: 16px;
flex-wrap: wrap;
}

.panel-day {
font-family: ‘Bebas Neue’, sans-serif;
font-size: 48px;
line-height: 1;
letter-spacing: 0.03em;
}

.panel-meta {
text-align: right;
}

.panel-tag {
display: inline-block;
font-family: ‘DM Mono’, monospace;
font-size: 10px;
letter-spacing: 0.15em;
padding: 4px 10px;
border-radius: 6px;
margin-bottom: 6px;
}

.panel-focus {
font-size: 13px;
color: var(–muted);
font-weight: 300;
}

/* ── SECTION LABEL ── */
.section-label {
font-family: ‘DM Mono’, monospace;
font-size: 10px;
letter-spacing: 0.18em;
text-transform: uppercase;
margin: 28px 0 12px;
padding-bottom: 8px;
border-bottom: 1px solid var(–border);
}

/* ── EXERCISE CARDS ── */
.exercises { display: flex; flex-direction: column; gap: 8px; }

.ex-card {
display: grid;
grid-template-columns: 1fr auto;
gap: 12px;
align-items: start;
background: var(–surface);
border: 1px solid var(–border);
border-radius: 12px;
padding: 16px 18px;
transition: border-color 0.2s, background 0.2s;
position: relative;
overflow: hidden;
}

.ex-card::before {
content: ‘’;
position: absolute;
left: 0; top: 0; bottom: 0;
width: 3px;
border-radius: 12px 0 0 12px;
}

.ex-card:hover { border-color: rgba(255,255,255,0.14); background: var(–surface2); }

.ex-name {
font-size: 14px;
font-weight: 500;
color: var(–text);
margin-bottom: 4px;
line-height: 1.3;
}

.ex-note {
font-size: 12px;
color: var(–muted);
font-weight: 300;
line-height: 1.5;
}

.ex-right { text-align: right; flex-shrink: 0; }

.ex-sets {
font-family: ‘DM Mono’, monospace;
font-size: 13px;
font-weight: 500;
white-space: nowrap;
margin-bottom: 4px;
}

.ex-min {
font-size: 11px;
color: var(–muted);
}

/* Colors per day */
.panel[data-day=“mo”] .ex-card::before { background: var(–mon); }
.panel[data-day=“mo”] .ex-sets { color: var(–mon); }
.panel[data-day=“mo”] .section-label { color: var(–mon); border-color: rgba(59,130,246,0.2); }

.panel[data-day=“mi”] .ex-card::before { background: var(–wed); }
.panel[data-day=“mi”] .ex-sets { color: var(–wed); }
.panel[data-day=“mi”] .section-label { color: var(–wed); border-color: rgba(34,197,94,0.2); }

.panel[data-day=“fr”] .ex-card::before { background: var(–fri); }
.panel[data-day=“fr”] .ex-sets { color: var(–fri); }
.panel[data-day=“fr”] .section-label { color: var(–fri); border-color: rgba(249,115,22,0.2); }

.panel[data-day=“sa”] .ex-card::before { background: var(–sat); }
.panel[data-day=“sa”] .ex-sets { color: var(–sat); }
.panel[data-day=“sa”] .section-label { color: var(–sat); border-color: rgba(168,85,247,0.2); }

.panel[data-day=“mob”] .ex-card::before { background: var(–mob); }
.panel[data-day=“mob”] .ex-sets { color: var(–mob); }
.panel[data-day=“mob”] .section-label { color: var(–mob); border-color: rgba(244,63,94,0.2); }

/* ── HIGHLIGHT CARD (Pflicht) ── */
.ex-card.highlight {
border-color: rgba(244,63,94,0.3);
background: rgba(244,63,94,0.06);
}
.ex-card.highlight::after {
content: ‘⚡ PFLICHT’;
position: absolute;
top: 10px; right: 14px;
font-family: ‘DM Mono’, monospace;
font-size: 9px;
letter-spacing: 0.15em;
color: var(–mob);
opacity: 0.8;
}
.ex-card.highlight .ex-right { margin-top: 18px; }

/* ── TIMER BADGE ── */
.timer-row {
display: flex;
gap: 8px;
align-items: center;
margin-top: 24px;
padding: 14px 18px;
background: var(–surface2);
border: 1px solid var(–border);
border-radius: 12px;
}
.timer-icon { font-size: 16px; }
.timer-label { font-size: 13px; color: var(–muted); }
.timer-val { font-family: ‘DM Mono’, monospace; font-size: 15px; font-weight: 500; margin-left: auto; }

/* ── FOOTER ── */
.footer {
margin-top: 64px;
padding-top: 24px;
border-top: 1px solid var(–border);
display: flex;
justify-content: space-between;
align-items: center;
flex-wrap: wrap;
gap: 12px;
}
.footer-name {
font-family: ‘Bebas Neue’, sans-serif;
font-size: 22px;
letter-spacing: 0.05em;
color: rgba(255,255,255,0.15);
}
.footer-note {
font-size: 11px;
color: var(–muted);
font-family: ‘DM Mono’, monospace;
}
</style>

</head>
